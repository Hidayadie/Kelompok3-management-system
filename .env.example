# Ganti dengan output: openssl rand -hex 32
JWT_SECRET=
PORT=8080
# Salin connection string dari Neon Dashboard > Connect.
# Host -pooler mendukung koneksi pooled. TLS wajib aktif.
DATABASE_URL='postgresql://USER:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Opsional: database khusus test integrasi, bukan database produksi.
TEST_DATABASE_URL=
# Opsional: path executable Python untuk modul text-analysis (K-Means & TF-IDF)
# Jika dikosongkan, server otomatis mencari python di PATH atau direktori venv lokal (.venv/venv).
TEXT_ANALYSIS_PYTHON=
# Opsional: custom script path jika tidak menggunakan internal/textanalysis/analyze_text.py
TEXT_ANALYSIS_SCRIPT=
